# MRI data — never commit patient or subject data
*.nii
*.nii.gz
*.dcm

# Large data files
*.mat
*.zip

# Example data and results
Example_Data/
Example_Results/*.mat

# Machine-specific config files (copy from *_template.m / *_template.py and edit)
MUMC_pipeline/paths.m
MUMC_pipeline/analysis/paths.py
MUMC_pipeline/analysis/cohort_paths.py
MUMC_pipeline/lambda_chi_cohort.txt

# External toolboxes (large, not project code)
sepia/

# MATLAB autosave files
*.asv

# Python bytecode
__pycache__/
*.pyc
*.pyo

# OS files
.DS_Store
Thumbs.db
